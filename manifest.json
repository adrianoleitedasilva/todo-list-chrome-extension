{
  "manifest_version": 3,
  "name": "ToDo List",
  "version": "1.0.0",
  "description": "Uma lista de tarefas simples direto no navegador.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ToDo List",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
